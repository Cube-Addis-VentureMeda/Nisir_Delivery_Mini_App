# ── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=nisir_delivery

# ── Security ────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=1h

# ── Telegram ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-from-botfather