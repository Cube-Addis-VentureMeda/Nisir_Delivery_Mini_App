{
  "compilerOptions": {
    "target": "ES2022",           
    "module": "commonjs",         
    "lib": ["ES2022"],
    "strict": true,               
    "esModuleInterop": true,      
    "skipLibCheck": true,        
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist",            
    "rootDir": ".",
    "sourceMap": true,            
    "types": ["node"],
  },
   "include": [
    "src/**/*.ts",
    "scripts/**/*.ts"
  ],
   "exclude": [
    "node_modules",
    "dist"
  ]
}